# ============================================================================
# Resellix - Environment Configuration Template
# ----------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# Every secret below is obtained from the respective provider dashboard.
# See SETUP_CHECKLIST.md for exactly where to get each value.
# ============================================================================

# --- Application -------------------------------------------------------------
NODE_ENV=development
# Public base URL of the deployed store (used in emails, webhooks, sitemaps).
# Local dev: http://localhost:3000
APP_URL=http://localhost:3000
APP_NAME=Zenvora

# --- Database (PostgreSQL) ----------------------------------------------------
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/resellix?schema=public
# Direct (NON-pooled) connection used by the Prisma CLI for migrations
# (`prisma migrate deploy`, which also runs automatically during the build).
#  - Local dev: identical to DATABASE_URL.
#  - Neon/Vercel: DATABASE_URL = the POOLED url (host ends in "-pooler") and
#    DIRECT_URL = the plain/direct url. Prisma Client uses DATABASE_URL at
#    runtime; migrations need the direct url to avoid pooler limitations.
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/resellix?schema=public

# --- Authentication -----------------------------------------------------------
# Lifetime of a customer/admin session cookie, in days.
SESSION_TTL_DAYS=30
# Password reset link lifetime, in minutes.
PASSWORD_RESET_TTL_MINUTES=60
# Seed script only: initial admin account created by `npm run db:seed`.
# Change/remove after first login in production.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Payments (Razorpay) ------------------------------------------------------
# When true AND no Razorpay keys are present, a clearly-labelled TEST payment
# provider is enabled (development only; refused when NODE_ENV=production).
PAYMENTS_TEST_MODE=true
# Razorpay Dashboard -> Settings -> API Keys (test mode keys first!)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Public-safe key id used by Checkout.js in the browser (rzp_test_... / rzp_live_...)
NEXT_PUBLIC_RAZORPAY_KEY_ID=
# Razorpay Dashboard -> Settings -> Webhooks -> add webhook -> signing secret
RAZORPAY_WEBHOOK_SECRET=

# --- Suppliers ----------------------------------------------------------------
# When true, a clearly-labelled DEMO supplier adapter is available for
# development/testing (refused when NODE_ENV=production).
SUPPLIER_DEMO_MODE=true
# Secret used to verify incoming supplier webhook calls to /api/suppliers/webhook.
# Generate a long random string yourself, e.g. `openssl rand -hex 32`.
SUPPLIER_WEBHOOK_SECRET=
# Per-supplier credentials for the generic HTTP-REST adapter are read from env
# vars referenced by each supplier record (field: apiKeyEnvVar), e.g.:
# SUPPLIER_ACME_API_KEY=
# SUPPLIER_ACME_API_SECRET=

# --- Background job runner (cron) ----------------------------------------------
# Shared secret for POST /api/cron/jobs (called by cron-job.org / Vercel Cron).
# Generate a long random string yourself.
CRON_SECRET=

# --- Email / Notifications -----------------------------------------------------
# console = log emails to server output (development)
# smtp    = send via any SMTP provider (Resend, Brevo, Amazon SES, Zoho, ...)
EMAIL_PROVIDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Resellix <no-reply@example.com>"
EMAIL_REPLY_TO=

# --- Test suite -----------------------------------------------------------------
# Separate PostgreSQL database used by `npm test` (integration tests reset it).
TEST_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/resellix_test?schema=public
# Base URL of a running server for HTTP end-to-end tests (`npm run test:e2e`).
E2E_BASE_URL=http://127.0.0.1:3100
